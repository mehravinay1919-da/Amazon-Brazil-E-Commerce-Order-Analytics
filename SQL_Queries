-- Q11. Find sellers who have fulfilled more orders than the average seller on the platform. 
with seller_orders as
(
select s.seller_id, 
	   count(distinct oi.order_id) as total_no_of_orders
from sellers s
left join order_items oi 
on s.seller_id = oi.seller_id
group by s.seller_id
),
average_orders as
(
select so.seller_id, 
	   so.total_no_of_orders,
       avg(so.total_no_of_orders) over() as average_no_of_orders 
from seller_orders so
)
select ao.seller_id, 
	   ao.total_no_of_orders, 
       ao.average_no_of_orders   
from average_orders ao
where ao.total_no_of_orders > ao.average_no_of_orders;

															-- Number_of_above_average_sellers 
with seller_orders as
(
select s.seller_id, 
	   count(distinct oi.order_id) as total_no_of_orders
from sellers s
left join order_items oi 
on s.seller_id = oi.seller_id
group by s.seller_id
),
average_orders as
(
select so.seller_id, 
	   so.total_no_of_orders,
       avg(so.total_no_of_orders) over() as average_no_of_orders 
from seller_orders so
),
above_average_sellers as 
(
select ao.seller_id, 
	   ao.total_no_of_orders, 
       ao.average_no_of_orders   
from average_orders ao
where ao.total_no_of_orders > ao.average_no_of_orders
)
select COUNT(*) as number_of_above_average_sellers
from above_average_sellers;



-- Q12. Find which Brazilian states have the highest average customer review score for orders delivered there. 
with state_wise_reviews as
(
select c.customer_state, 
	   round(avg(rev.review_score),2) as average_customer_review_score 
from customers c
join orders o
on c.customer_id = o.customer_id
join order_reviews rev
on o.order_id = rev.order_id
group by c.customer_state
)
select swr.customer_state, 
	   swr.average_customer_review_score,
       dense_rank() over(order by average_customer_review_score desc) as state_rank
from state_wise_reviews swr;

-- Q13. Identify customers who have placed orders but never left a review. 
select distinct c.customer_id 
from customers c
join orders o
on c.customer_id = o.customer_id
left join order_reviews rev
on o.order_id = rev.order_id
where rev.review_id is null;	
																-- No. of such customers
select count(distinct c.customer_id) as no_of_reviewless_customers 
from customers c
join orders o
on c.customer_id = o.customer_id
left join order_reviews rev
on o.order_id = rev.order_id
where rev.review_id is null;

-- Q14. Find the month with the highest number of orders placed across the entire platform. 
SELECT 
    DATE_FORMAT(order_purchase_timestamp, '%b %Y') AS order_month,
    COUNT(*) AS total_orders
FROM orders
GROUP BY DATE_FORMAT(order_purchase_timestamp, '%b %Y')
ORDER BY total_orders DESC
LIMIT 1;





